# MongoDB connection string (falls back to in-memory seed data when unset)
MONGODB_URI=
MONGODB_DB_NAME=studiospace

# Secret used to sign JWT session cookies (use a long random string in production)
JWT_SECRET=

# imgbb API key for the Add/Update Studio image uploader
# (https://api.imgbb.com/ — free key; when unset, paste Image URLs instead)
IMGBB_API_KEY=
